{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist-electron",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": [
    "src/electron/**/*",
    "src/shared/**/*",
    "src/cli/port-finder.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "src/client/**/*",
    "**/*.test.ts"
  ]
}
