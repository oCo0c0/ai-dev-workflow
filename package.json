{
  "name": "ai-dev-workbench",
  "version": "2.0.1",
  "description": "AI-powered development workbench integrating requirements, coding, and testing",
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "bin": {
    "adw": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "templates/",
    "skills/",
    "README.md",
    "README_ZH.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm run build:frontend && pnpm run build:backend && pnpm run build:bridge",
    "build:frontend": "vite build",
    "build:backend": "node -e \"const fs=require('fs');['dist/server','dist/cli'].forEach(d=>{try{fs.rmSync(d,{recursive:true})}catch{}})\" && tsc -p tsconfig.server.json",
    "build:bridge": "node -e \"const fs=require('fs');const p=require('path');const d=p.join('dist','bridge');fs.mkdirSync(d,{recursive:true});fs.copyFileSync(p.join('src','bridge','claude-bridge.mjs'),p.join(d,'claude-bridge.mjs'));const t=p.join('dist','templates');fs.mkdirSync(t,{recursive:true});fs.copyFileSync(p.join('templates','task-split-effort-template.xlsx'),p.join(t,'task-split-effort-template.xlsx'));const sk=p.join('dist','skills');fs.mkdirSync(sk,{recursive:true});const src=p.join('skills');if(fs.existsSync(src)){for(const e of fs.readdirSync(src,{withFileTypes:true})){if(e.isDirectory()){const sDir=p.join(src,e.name);const dDir=p.join(sk,e.name);fs.mkdirSync(dDir,{recursive:true});const md=p.join(sDir,'SKILL.md');if(fs.existsSync(md))fs.copyFileSync(md,p.join(dDir,'SKILL.md'))}}}\"",
    "dev": "concurrently -n fe,be -c blue,green \"vite\" \"tsx src/dev-server.ts\"",
    "dev:be": "tsx src/dev-server.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest --run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ai",
    "development",
    "workbench",
    "cli",
    "mcp",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "@daytona/sdk": "^0.192.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.130.0",
    "@types/adm-zip": "^0.5.8",
    "@types/multer": "^2.1.0",
    "adm-zip": "^0.5.17",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "i18next": "^26.3.0",
    "multer": "^2.1.1",
    "react-i18next": "^17.0.8",
    "react-joyride": "^3.1.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "fast-check": "^3.22.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.13.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vite": "8.0.5",
    "vitest": "^1.6.0",
    "zustand": "^4.5.5"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
