{
  "name": "ai-dev-workbench",
  "version": "1.1.5 fix-codex",
  "description": "AI-powered development workbench integrating requirements, coding, and testing",
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "bin": {
    "adw": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "README_ZH.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run build:frontend && npm run build:backend && npm run build:bridge",
    "build:frontend": "vite build",
    "build:backend": "node -e \"const fs=require('fs');['dist/server','dist/cli'].forEach(d=>{try{fs.rmSync(d,{recursive:true})}catch{}})\" && tsc -p tsconfig.server.json",
    "build:bridge": "node -e \"const fs=require('fs');const p=require('path');const d=p.join('dist','bridge');fs.mkdirSync(d,{recursive:true});fs.copyFileSync(p.join('src','bridge','claude-bridge.mjs'),p.join(d,'claude-bridge.mjs'))\"",
    "dev": "concurrently -n fe,be -c blue,green \"vite\" \"tsx src/dev-server.ts\"",
    "dev:be": "tsx src/dev-server.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest --run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "development",
    "workbench",
    "cli",
    "mcp",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@daytonaio/sdk": "^0.173.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.130.0",
    "@types/multer": "^2.1.0",
    "cors": "^2.8.6",
    "express": "^4.21.0",
    "i18next": "^26.3.0",
    "multer": "^2.1.1",
    "react-i18next": "^17.0.8",
    "react-joyride": "^3.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "fast-check": "^3.22.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.13.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vite": "8.0.5",
    "vitest": "^1.6.0",
    "zustand": "^4.5.5"
  }
}
