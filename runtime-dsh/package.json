    "adw-dsh-runtime": "./bin.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node check.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
