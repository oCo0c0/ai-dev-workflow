{
  "name": "@along/adw-dsh-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-contained DeepSeek Harness SDK runtime for adw's dsh-provider: spawns an unattended JSON-RPC agent driven by a generated cordis.yml. Isolated from the adw root dependency tree by design.",
